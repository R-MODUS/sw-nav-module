<?xml version='1.0'?>
<!-- Host links only (no <robot> wrapper). Expects base_cfg and drive_cfg in scope. -->

<robot xmlns:xacro='http://www.ros.org/wiki/xacro'>

<xacro:macro name='rmodus_chassis_box_inertia' params='m x y z'>
  <inertial>
    <mass value='${m}'/>
    <inertia ixx='${m/12 * (y*y + z*z)}' ixy='0.0' ixz='0.0'
             iyy='${m/12 * (x*x + z*z)}' iyz='0.0'
             izz='${m/12 * (x*x + y*y)}'/>
  </inertial>
</xacro:macro>

<xacro:macro name='rmodus_chassis_links'>
  <xacro:property name='base_mass' value='${base_cfg["mass"]}'/>
  <xacro:property name='base_size_x' value='${base_cfg["size"][0]}'/>
  <xacro:property name='base_size_y' value='${base_cfg["size"][1]}'/>
  <xacro:property name='base_size_z' value='${base_cfg["size"][2]}'/>
  <xacro:property name='base_offset_z' value='${base_cfg["offset_z"]}'/>

  <link name='base_footprint'/>

  <link name='base_link'>
    <xacro:rmodus_chassis_box_inertia m='${base_mass}' x='${base_size_x}' y='${base_size_y}' z='${base_size_z}'/>
    <visual>
      <geometry><box size='${base_size_x} ${base_size_y} ${base_size_z}'/></geometry>
      <material name='chassis_mat'>
        <color rgba='0.28 0.31 0.35 1'/>
      </material>
    </visual>
    <collision>
      <geometry><box size='${base_size_x} ${base_size_y} ${base_size_z}'/></geometry>
    </collision>
  </link>

  <joint name='body_link_joint' type='fixed'>
    <parent link='base_footprint'/>
    <child link='base_link'/>
    <origin xyz='0 0 ${base_offset_z}' rpy='0 0 0'/>
  </joint>

  <xacro:rmodus_chassis_wheels/>
</xacro:macro>

<!-- Wheel centre z sits wheel_radius above base_footprint. Fixed joints: TF must not wait for /joint_states. -->
<xacro:macro name='rmodus_chassis_wheel' params='name x y radius width z'>
  <link name='${name}_link'>
    <xacro:rmodus_chassis_box_inertia m='0.3' x='${2*radius}' y='${width}' z='${2*radius}'/>
    <visual>
      <origin xyz='0 0 0' rpy='${pi/2} 0 0'/>
      <geometry><cylinder radius='${radius}' length='${width}'/></geometry>
      <material name='wheel_mat'/>
    </visual>
    <collision>
      <origin xyz='0 0 0' rpy='${pi/2} 0 0'/>
      <geometry><cylinder radius='${radius}' length='${width}'/></geometry>
    </collision>
  </link>
  <joint name='${name}' type='fixed'>
    <parent link='base_link'/>
    <child link='${name}_link'/>
    <origin xyz='${x} ${y} ${z}' rpy='0 0 0'/>
  </joint>
</xacro:macro>

<xacro:macro name='rmodus_chassis_wheels'>
  <xacro:property name='wheel_mode' value='${drive_cfg.get("mode", "")}'/>
  <xacro:property name='wheel_r' value='${float(drive_cfg.get("wheel_radius", 0.05))}'/>
  <xacro:property name='wheel_w' value='${float(drive_cfg.get("wheel_width", 0.04))}'/>
  <xacro:property name='wheel_hx' value='${float(drive_cfg.get("wheelbase", 0.0)) / 2.0}'/>
  <xacro:property name='wheel_hy' value='${float(drive_cfg.get("track_width", 0.3)) / 2.0}'/>
  <xacro:property name='wheel_z' value='${wheel_r - float(base_cfg["offset_z"])}'/>

  <material name='wheel_mat'>
    <color rgba='0.10 0.10 0.11 1'/>
  </material>

  <xacro:if value='${wheel_mode in ("mecanum", "diff4")}'>
    <xacro:rmodus_chassis_wheel name='wheel_fl' x='${wheel_hx}' y='${wheel_hy}' radius='${wheel_r}' width='${wheel_w}' z='${wheel_z}'/>
    <xacro:rmodus_chassis_wheel name='wheel_fr' x='${wheel_hx}' y='${-wheel_hy}' radius='${wheel_r}' width='${wheel_w}' z='${wheel_z}'/>
    <xacro:rmodus_chassis_wheel name='wheel_rl' x='${-wheel_hx}' y='${wheel_hy}' radius='${wheel_r}' width='${wheel_w}' z='${wheel_z}'/>
    <xacro:rmodus_chassis_wheel name='wheel_rr' x='${-wheel_hx}' y='${-wheel_hy}' radius='${wheel_r}' width='${wheel_w}' z='${wheel_z}'/>
  </xacro:if>
  <xacro:if value='${wheel_mode == "diff2"}'>
    <xacro:rmodus_chassis_wheel name='wheel_l' x='0.0' y='${wheel_hy}' radius='${wheel_r}' width='${wheel_w}' z='${wheel_z}'/>
    <xacro:rmodus_chassis_wheel name='wheel_r' x='0.0' y='${-wheel_hy}' radius='${wheel_r}' width='${wheel_w}' z='${wheel_z}'/>
  </xacro:if>
</xacro:macro>

</robot>
