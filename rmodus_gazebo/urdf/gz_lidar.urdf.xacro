<?xml version='1.0'?>
<!-- GPU lidar on the description frame lidar_beam. Topic follows lidar.topic. -->

<robot xmlns:xacro='http://www.ros.org/wiki/xacro'>

<xacro:property name='lidar_samples' value='${max(1, int(round(float(lidar_cfg.get("fov", 360)) / max(float(lidar_cfg.get("resolution", 1.0)), 1e-6))))}'/>

<gazebo reference='lidar_mount_joint'>
  <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>
<gazebo reference='lidar_joint'>
  <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>

<gazebo reference='lidar_beam'>
  <sensor name='lidar' type='gpu_ray'>
    <always_on>1</always_on>
    <visualize>${str(lidar_cfg.get("visualize", False)).lower()}</visualize>
    <update_rate>${lidar_cfg.get("update_rate", 10)}</update_rate>
    <topic>${lidar_cfg.get("topic", "/scan")}</topic>
    <gz_frame_id>${lidar_cfg.get("frame_id", "lidar_beam")}</gz_frame_id>
    <ray>
      <scan>
        <horizontal>
          <samples>${lidar_samples}</samples>
          <resolution>1</resolution>
          <min_angle>${lidar_cfg.get("angle_min", 0.0)}</min_angle>
          <max_angle>${lidar_cfg.get("angle_max", 6.28318530718)}</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>${lidar_cfg.get("range_min", 0.05)}</min>
        <max>${lidar_cfg.get("range_max", 5.0)}</max>
      </range>
    </ray>
  </sensor>
</gazebo>

</robot>
