<?xml version='1.0'?>
<!-- Ray <name>_ray on the beam link: frame_id, or <name>_beam.
     Publishes LaserScan on /sim/cliff/<name>/scan; sim_cliff_bridge packs meters
     into cliff_sensors.state_topic. rmodus_cliff_sensor turns that into Range.
     name is the whole stem (fl or cliff_sensor_fl). -->

<robot xmlns:xacro='http://www.ros.org/wiki/xacro'>

<xacro:macro name='gz_cliff_sensor' params='c'>
  <xacro:if value='${c.get("enabled", True)}'>
    <xacro:property name='cframe' value='${c.get("frame_id") or c["name"] + "_beam"}'/>
    <gazebo reference='${c["name"]}_mount_joint'>
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference='${c["name"]}_beam_joint'>
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference='${cframe}'>
      <sensor name='${c["name"]}_ray' type='gpu_ray'>
        <always_on>1</always_on>
        <update_rate>${c.get("update_rate", 20)}</update_rate>
        <visualize>${str(c.get("visualize", False)).lower()}</visualize>
        <topic>/sim/cliff/${c["name"]}/scan</topic>
        <gz_frame_id>${cframe}</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>-0.01</min_angle>
              <max_angle>0.01</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${c.get("range_min", 0.01)}</min>
            <max>${c.get("range_max", 0.5)}</max>
          </range>
        </ray>
      </sensor>
    </gazebo>
  </xacro:if>
</xacro:macro>

<xacro:macro name='gz_cliff_sensor_loop' params='items'>
  <xacro:if value='${items}'>
    <xacro:property name='current_c' value='${items.pop(0)}'/>
    <xacro:gz_cliff_sensor c='${current_c}'/>
    <xacro:gz_cliff_sensor_loop items='${items}'/>
  </xacro:if>
</xacro:macro>

<xacro:gz_cliff_sensor_loop items='${list(cliff_sensors)}'/>

</robot>
