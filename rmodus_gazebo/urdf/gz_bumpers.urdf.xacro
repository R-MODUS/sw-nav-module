<?xml version='1.0'?>
<!-- Contact sensor <name>_sensor on link <name>_mount. The world already loads Contact.
     Harmonic publishes
     /world/my_world/model/rmodus/link/<name>_mount/sensor/<name>_sensor/contact.
     The bridge maps that onto /sim/bumper/<name>/contact.
     URDF collision is named <name>_mount; the filter uses <name>_mount_collision
     because sdformat appends _collision itself. -->

<robot xmlns:xacro='http://www.ros.org/wiki/xacro'>

<xacro:macro name='gz_bumper_sensors' params='b'>
  <xacro:if value='${b.get("enabled", True)}'>
    <gazebo reference='${b["name"]}_mount_joint'>
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference='${b["name"]}_contact_joint'>
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>
    <gazebo reference='${b["name"]}_mount'>
      <sensor name='${b["name"]}_sensor' type='contact'>
        <always_on>1</always_on>
        <update_rate>${b.get("update_rate", 30)}</update_rate>
        <topic>/sim/bumper/${b["name"]}/contact</topic>
        <contact>
          <collision>${b["name"]}_mount_collision</collision>
        </contact>
      </sensor>
    </gazebo>
  </xacro:if>
</xacro:macro>

<xacro:macro name='gz_bumper_loop' params='items'>
  <xacro:if value='${items}'>
    <xacro:property name='current_b' value='${items.pop(0)}'/>
    <xacro:gz_bumper_sensors b='${current_b}'/>
    <xacro:gz_bumper_loop items='${items}'/>
  </xacro:if>
</xacro:macro>

<xacro:gz_bumper_loop items='${list(bumpers)}'/>

</robot>
