<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rmodus_bringup</name>
  <version>0.0.0</version>
  <description>R-MODUS bringup: one profile + rmodus.launch.py (optional modules gated at launch)</description>
  <maintainer email="pi@todo.todo">pi</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>

  <!-- Hard deps: only what is needed to parse/run the bringup launch itself. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!--
    Optional R-MODUS / heavy packages — NOT exec_depend (rosdep will not pull them).
    Launch checks PackageNotFound and skips with a log.
    sw_install should read <export><rmodus><optional_depend>…</optional_depend>.
  -->

  <export>
    <build_type>ament_python</build_type>
    <rmodus>
      <optional_depend>rmodus_chassis</optional_depend>
      <optional_depend>rmodus_description</optional_depend>
      <optional_depend>rmodus_hw</optional_depend>
      <optional_depend>rmodus_uart_output</optional_depend>
      <optional_depend>rmodus_estop</optional_depend>
      <optional_depend>rmodus_bumper</optional_depend>
      <optional_depend>rmodus_cliff_sensor</optional_depend>
      <optional_depend>rmodus_flow_sensor</optional_depend>
      <optional_depend>rmodus_display</optional_depend>
      <optional_depend>rmodus_web</optional_depend>
      <optional_depend>rmodus_localization</optional_depend>
      <optional_depend>rmodus_navigation</optional_depend>
      <optional_depend>rmodus_gazebo</optional_depend>
      <optional_depend>rviz2</optional_depend>
      <optional_depend>rf2o_laser_odometry</optional_depend>
      <optional_depend>slam_toolbox</optional_depend>
      <optional_depend>nav2_common</optional_depend>
      <optional_depend>nav2_bringup</optional_depend>
      <optional_depend>ros_gz_sim</optional_depend>
      <optional_depend>ros_gz_bridge</optional_depend>
    </rmodus>
  </export>
</package>
