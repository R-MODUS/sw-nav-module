<?xml version='1.0'?>
<!-- Drive + joint states. Joint names match rmodus_chassis (wheel_fl, not *_joint). -->

<robot xmlns:xacro='http://www.ros.org/wiki/xacro'
       xmlns:gz='http://gazebosim.org/schema'>

<xacro:property name='drive_on' value='${bool(drive_cfg.get("enabled", False))}'/>
<xacro:property name='drive_mode' value='${drive_cfg.get("mode", "")}'/>
<xacro:property name='wheel_radius' value='${float(drive_cfg.get("wheel_radius", 0.05))}'/>
<xacro:property name='track_width' value='${float(drive_cfg.get("track_width", 0.3))}'/>
<xacro:property name='wheelbase' value='${float(drive_cfg.get("wheelbase", 0.0))}'/>
<xacro:property name='cmd_topic' value='${params.get("cmd_mux", dict()).get("output_topic", "/cmd_vel")}'/>
<xacro:property name='odom_topic' value='${params.get("wheel_odom", dict()).get("topic", "/odom")}'/>

<xacro:macro name='mecanum_friction' params='link fdir'>
  <gazebo reference='${link}'>
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.1</mu>
            <mu2>0.15</mu2>
            <fdir1 gz:expressed_in='base_footprint'>${fdir}</fdir1>
          </ode>
        </friction>
      </surface>
    </collision>
  </gazebo>
</xacro:macro>

<gazebo reference='body_link_joint'>
  <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>
<gazebo reference='rmodus_mount_joint'>
  <preserveFixedJoint>true</preserveFixedJoint>
</gazebo>

<gazebo>
  <plugin
    filename='libgz-sim-joint-state-publisher-system.so'
    name='gz::sim::systems::JointStatePublisher'>
    <topic>joint_states</topic>
  </plugin>
</gazebo>

<xacro:if value='${drive_on and drive_mode == "mecanum"}'>
  <gazebo>
    <plugin
      filename='libgz-sim-mecanum-drive-system.so'
      name='gz::sim::systems::MecanumDrive'>
      <front_left_joint>wheel_fl</front_left_joint>
      <front_right_joint>wheel_fr</front_right_joint>
      <back_left_joint>wheel_rl</back_left_joint>
      <back_right_joint>wheel_rr</back_right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheelbase>${wheelbase}</wheelbase>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>${cmd_topic}</topic>
      <odom_topic>${odom_topic}</odom_topic>
      <tf_topic>gz_unused_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>

  <!-- Roller slip directions in the footprint frame (X mecanum). -->
  <xacro:mecanum_friction link='wheel_fl_link' fdir='1 -1 0'/>
  <xacro:mecanum_friction link='wheel_fr_link' fdir='1 1 0'/>
  <xacro:mecanum_friction link='wheel_rl_link' fdir='1 1 0'/>
  <xacro:mecanum_friction link='wheel_rr_link' fdir='1 -1 0'/>
</xacro:if>

<xacro:if value='${drive_on and drive_mode == "diff4"}'>
  <gazebo>
    <plugin
      filename='libgz-sim-diff-drive-system.so'
      name='gz::sim::systems::DiffDrive'>
      <left_joint>wheel_fl</left_joint>
      <left_joint>wheel_rl</left_joint>
      <right_joint>wheel_fr</right_joint>
      <right_joint>wheel_rr</right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>${cmd_topic}</topic>
      <odom_topic>${odom_topic}</odom_topic>
      <tf_topic>gz_unused_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>
</xacro:if>

<xacro:if value='${drive_on and drive_mode == "diff2"}'>
  <gazebo>
    <plugin
      filename='libgz-sim-diff-drive-system.so'
      name='gz::sim::systems::DiffDrive'>
      <left_joint>wheel_l</left_joint>
      <right_joint>wheel_r</right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>${cmd_topic}</topic>
      <odom_topic>${odom_topic}</odom_topic>
      <tf_topic>gz_unused_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>
  </gazebo>
</xacro:if>

</robot>
